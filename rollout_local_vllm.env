# Local model rollout config for rollout_local_vllm_frank.sbatch.
# This file has no API keys; vLLM serves a local OpenAI-compatible endpoint.

MODEL=Qwen/Qwen3.5-4B
NUM_EPISODES=10
NUM_ENVS=8
SEED_BASE=0

# Optional label appended to default episode/game log filenames.
# Example: ROLLOUT_POSTFIX=qwen35_4b_smoke
ROLLOUT_POSTFIX=

TEMPERATURE=1.0
# Set TOP_P=1.0 for training-run parity; leave empty to use vLLM/provider default.
TOP_P=
MAX_OUTPUT_TOKENS=512
REQUEST_LOGPROBS=0

# Qwen3 defaults to explicit thinking mode in many chat templates. Disabling it
# avoids long lowercase <think> generations that do not match the env action tags.
LOCAL_VLLM_DISABLE_THINKING=1
# Optional raw JSON merged into each local-vLLM chat/completions payload.
LOCAL_VLLM_EXTRA_BODY_JSON=

# vLLM server settings.
VLLM_HOST=127.0.0.1
# Leave VLLM_PORT empty to derive a per-job port from SLURM_JOB_ID.
VLLM_PORT=
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=8192
VLLM_DTYPE=auto
VLLM_READY_TIMEOUT=900

# Extra args are split by bash words. Keep simple, e.g.:
# VLLM_EXTRA_ARGS=--trust-remote-code
VLLM_EXTRA_ARGS=
