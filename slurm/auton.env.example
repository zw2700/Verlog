# Copy to slurm/auton.env and edit. Sourced by slurm/common.sh.
# slurm/auton.env is git-ignored (holds machine paths + secrets).

# Conda env prefix that has verl + deps installed.
export ENV_PATH="/zfsauton/scratch/cpulling/conda_envs/verlog"

# Directory containing train.parquet / test.parquet.
export DATA_DIR="/zfsauton/scratch/cpulling/data/gsm8k"

# Optional: defaults to the repo root if unset.
# export PROJECT_DIR="/zfsauton2/home/you/unscripted/Verlog"

# Model (read by the Hydra config via ${oc.env:MODEL_PATH,...}).
export MODEL_PATH="Qwen/Qwen3-4B"

# Caches (optional; sensible defaults under the repo if unset).
# export HF_HOME="/zfsauton/scratch/you/.cache/huggingface"
# export TMPDIR="/zfsauton/scratch/you/tmp"

# Secret — do NOT commit the real value.
export WANDB_API_KEY="REPLACE_ME"
