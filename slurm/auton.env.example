# Copy to slurm/auton.env and edit. Sourced by slurm/common.sh.
# slurm/auton.env is git-ignored (holds machine paths + secrets).

# Conda env prefix that has verl + deps installed.
export ENV_PATH="/zfsauton/scratch/cpulling/conda_envs/verlog"

# Directory containing train.parquet / test.parquet.
export DATA_DIR="/zfsauton/scratch/cpulling/data/gsm8k"

# Optional: defaults to the repo root if unset.
# export PROJECT_DIR="/zfsauton2/home/you/unscripted/Verlog"

# Model (read by the Hydra config via ${oc.env:MODEL_PATH,...}).
export MODEL_PATH="Qwen/Qwen3-4B"

# Persistent cache and checkpoint paths (optional; default under the repo).
# Ray scratch is job-scoped under SLURM_TMPDIR, or /tmp if it is unset.
# export HF_HOME="/zfsauton/scratch/you/.cache/huggingface"
# export CHECKPOINT_ROOT="/zfsauton/scratch/you/unscripted/Verlog/checkpoints"

# GPU allocation guard. The launcher requeues allocations spanning NUMA
# sockets by default. Set ALLOW_SPLIT_GPUS=1 only to accept the slowdown.
# export MAX_SPLIT_GPU_REQUEUES=5
# export ALLOW_SPLIT_GPUS=0

# Lightweight per-episode phase timing; enabled by default.
# export VERL_PROFILE_AGENT_LOOP=1

# Optional secret for environments where `wandb login` has not populated
# ~/.netrc. Do NOT commit a real value.
# export WANDB_API_KEY="REPLACE_ME"
