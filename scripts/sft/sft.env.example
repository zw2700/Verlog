# Copy this file to scripts/sft/sft.env and fill in the credentials you use.
# scripts/sft/sft.env is ignored by git. Do not commit API keys.

PROVIDER=cmu-gateway
MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
CMU_GATEWAY_API_KEY=

TEMPERATURE=1.0
MAX_OUTPUT_TOKENS=512

# Other supported credentials, if you change PROVIDER:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# LOCAL_VLLM_API_KEY=dummy
