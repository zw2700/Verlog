{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "white",
  "data": {"url": "critic_actor_curves.csv"},
  "spacing": 34,
  "vconcat": [
    {
      "width": 940,
      "height": 170,
      "title": {"text": "Social-optimal rate", "anchor": "start", "fontSize": 22, "fontWeight": 600},
      "layer": [
        {
          "transform": [{"filter": "datum.metric === 'Social-optimal rate'"}],
          "mark": {"type": "line", "strokeWidth": 3},
          "encoding": {
            "x": {"field": "step", "type": "quantitative", "title": null, "scale": {"domain": [1, 95]}},
            "y": {"field": "value", "type": "quantitative", "title": null, "scale": {"domain": [0.25, 0.7]}, "axis": {"format": ".0%"}},
            "color": {"field": "condition", "type": "nominal", "scale": {"domain": ["Privileged", "Vanilla"], "range": ["#111111", "#777777"]}, "legend": {"orient": "top", "title": null, "labelFontSize": 16}},
            "strokeDash": {"field": "condition", "type": "nominal", "scale": {"domain": ["Privileged", "Vanilla"], "range": [[1, 0], [8, 5]]}, "legend": null}
          }
        },
        {"data": {"values": [{"step": 30}]}, "mark": {"type": "rule", "color": "#999999", "strokeDash": [4, 4]}, "encoding": {"x": {"field": "step", "type": "quantitative"}}}
      ]
    },
    {
      "width": 940,
      "height": 170,
      "title": {"text": "Social-welfare efficiency", "anchor": "start", "fontSize": 22, "fontWeight": 600},
      "layer": [
        {
          "transform": [{"filter": "datum.metric === 'Social-welfare efficiency'"}],
          "mark": {"type": "line", "strokeWidth": 3},
          "encoding": {
            "x": {"field": "step", "type": "quantitative", "title": "training step", "scale": {"domain": [1, 95]}},
            "y": {"field": "value", "type": "quantitative", "title": null, "scale": {"domain": [0.68, 1.0]}, "axis": {"format": ".0%"}},
            "color": {"field": "condition", "type": "nominal", "scale": {"domain": ["Privileged", "Vanilla"], "range": ["#111111", "#777777"]}, "legend": null},
            "strokeDash": {"field": "condition", "type": "nominal", "scale": {"domain": ["Privileged", "Vanilla"], "range": [[1, 0], [8, 5]]}, "legend": null}
          }
        },
        {"data": {"values": [{"step": 30}]}, "mark": {"type": "rule", "color": "#999999", "strokeDash": [4, 4]}, "encoding": {"x": {"field": "step", "type": "quantitative"}}}
      ]
    }
  ],
  "config": {
    "font": "Helvetica, Arial, sans-serif",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 15, "titleFontSize": 16, "gridColor": "#e5e5e5", "domainColor": "#222222", "tickColor": "#777777"}
  }
}
